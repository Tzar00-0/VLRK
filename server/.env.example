# Environment Variables for VLRK Server

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vlrk?schema=public"

# JWT
JWT_SECRET=vlrk-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# SMTP Email (optional - logs to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VLRK Reservasi <noreply@vlrk.com>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
